APP_NAME=AI Companion FastAPI
APP_ENV=development
HOST=127.0.0.1
PORT=8000

MONGO_URI=mongodb://127.0.0.1:27017/AI-companion-db
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=AI Companion

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/auth/google/callback
GOOGLE_AUTH_SUCCESS_REDIRECT=http://127.0.0.1:8000/login
GOOGLE_AUTH_FAILURE_REDIRECT=http://127.0.0.1:8000/login?googleError=1

# OpenAI-compatible chat settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://models.inference.ai.azure.com/
OPENAI_MODEL=gpt-4o
