APP_NAME="AI Companion FastAPI"
APP_ENV=development
# Developer-only companion telemetry. This is ignored when APP_ENV=production.
COMPANION_DEBUG=false
HOST=127.0.0.1
PORT=8000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
ADMIN_API_KEY=
# Accounts in this comma-separated allowlist receive administrator and full-plan access.
ADMIN_EMAILS=hemu171807@gmail.com,emoracomapnion@gmail.com
RATE_LIMIT_ENABLED=true
REDIS_URL=
REDIS_RATE_LIMIT_PREFIX=emora:rate-limit
CLAMAV_SOCKET=
AUDIO_CACHE_MAX_AGE_DAYS=7
TTS_WORKER_COUNT=4
TTS_QUEUE_MAX_PENDING=24
# Keep part of the queue available to Complete/admin accounts during bursts.
TTS_PRIORITY_RESERVED=4
TTS_QUEUE_WAIT_SECONDS=3
# qwen3-mlx uses the local, Apple-Silicon MLX runtime. Set kokoro to force fallback.
TTS_ENGINE=qwen3-mlx
TTS_QWEN_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit
TTS_STREAMING_INTERVAL=0.32
TTS_SAMPLE_RATE=24000
# Leave blank to use models/voices/pronunciations.json.
TTS_PRONUNCIATION_DICTIONARY=

# Local Qwen text chat. Weights download once into the Hugging Face cache,
# then load once per running server process.
CHAT_MLX_MODEL=Qwen/Qwen3-4B-MLX-4bit
CHAT_MLX_MAX_TOKENS=1024
CHAT_MLX_TEMPERATURE=0.7
# Direct mode is faster and gives conversational replies; enable only when
# deliberately evaluating Qwen's private reasoning mode.
CHAT_MLX_ENABLE_THINKING=false
# auto uses private thinking only for complex technical/planning turns;
# use never for fastest responses or always only while evaluating it.
CHAT_MLX_THINKING_MODE=auto
# Local MLX generation is serialized safely; concurrent users wait in this
# bounded priority queue instead of blocking FastAPI's shared thread pool.
CHAT_WORKER_COUNT=1
CHAT_QUEUE_MAX_PENDING=32
CHAT_QUEUE_WAIT_SECONDS=3
# Controlled current-information retrieval. The secret stays server-side.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_RETRIES=1
WEB_SEARCH_CACHE_ENABLED=true
WEB_SEARCH_CACHE_SECONDS=300
WEB_SEARCH_MAX_TOOL_ITERATIONS=3
# Optional camera check-ins use this compact 4-bit MLX vision model locally.
VISION_MLX_MODEL=mlx-community/Qwen2-VL-2B-Instruct-4bit
VISION_MLX_MAX_TOKENS=180

MONGO_URI=mongodb://127.0.0.1:27017/ai-companion-fastapi
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/auth/google/callback
GOOGLE_AUTH_SUCCESS_REDIRECT=http://127.0.0.1:8000/dashboard
GOOGLE_AUTH_FAILURE_REDIRECT=http://127.0.0.1:8000/login?googleError=1

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME="AI Companion"
